# LLM (CS1 LiteLLM proxy)
LLM_ENDPOINT=https://litellm.aie.cs1.ctc.sg.lab/v1
LLM_API_KEY=«your-cs1-key»
LLM_MODEL=muse-glimmer-30b

# Flask
FLASK_PORT=18080

# GitLab integration mode: real | mock
GITLAB_MODE=mock
GITLAB_URL=http://localhost:18929
GITLAB_TOKEN=
GITLAB_PROJECT_ID=1
WEBHOOK_SECRET=demo-secret
SSL_CA_CERT=/ca/cs1-ca-bundle.pem
